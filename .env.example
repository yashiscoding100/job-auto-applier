# Free Gemini API Key (Get free from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail credentials for reading placement emails
# Use a Gmail "App Password" (NOT your regular account password)
# Generated from: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Email filter settings
PLACEMENT_EMAIL_SUBJECT=god bless you
IMAP_SERVER=imap.gmail.com
